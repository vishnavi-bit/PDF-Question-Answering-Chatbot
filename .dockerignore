# Files Docker should NOT copy into the image
.git
.gitignore
**/__pycache__
**/*.pyc
backend/.venv
backend/.pytest_cache
backend/data
backend/.env
frontend/node_modules
frontend/dist
frontend/coverage
storage
docs
**/*.log
.env
.env.*
!backend/.env.example

# Tests are not needed in the runtime image
backend/tests
