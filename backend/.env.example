# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env (it is listed in .gitignore).

# --- Google Gemini API ----------------------------------------------------
# Create a free key in Google AI Studio: https://aistudio.google.com/apikey
# Paste it after the = sign below. Without a key the app still starts, but
# questions cannot be answered and the app shows a clear message.
GEMINI_API_KEY=
# Model used for answers and summaries. Check the current free-tier models in
# Google AI Studio before changing this (availability can change).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=90
GEMINI_TOTAL_TIME_BUDGET_SECONDS=150
# --- Reliability (optional; the defaults are sensible) ----------------
# After this many outage-type failures in a row, requests fail fast for the cooldown.
GEMINI_FAILURE_THRESHOLD=3
GEMINI_COOLDOWN_SECONDS=60
# Identical questions reuse the answer for this many seconds (0 turns the cache off).
GEMINI_CACHE_TTL_SECONDS=900
GEMINI_CACHE_MAX_ENTRIES=200
# Repeated identical requests return the first result for this many seconds.
REQUEST_DEDUPE_TTL_SECONDS=120

# --- Storage ----------------------------------------------------------
# Relative paths are resolved from the backend/ folder.
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIRECTORY=../storage/chroma_db
UPLOAD_DIRECTORY=../storage/uploads

# --- Embeddings -------------------------------------------------------
# Downloaded from Hugging Face the first time the backend needs it (about 90 MB).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Web ----------------------------------------------------------------
# The frontend address allowed by CORS. The Vite dev server uses 5173.
FRONTEND_URL=http://localhost:5173

# --- Uploads and retrieval ---------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=1000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Chunks scoring below this cosine similarity (0 to 1) are ignored, so unrelated
# questions do not get made-up answers. Raise it for stricter answers.
MIN_SIMILARITY=0.25
